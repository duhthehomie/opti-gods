{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions exposed to the main app window.",
  "windows": ["main", "splash"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "shell:allow-open",
    "dialog:default",
    "process:default",
    "http:default",
    "fs:default",
    "os:default",
    "notification:default",
    "updater:default",
    "allow-finish-splash",
    "allow-apply-tweak",
    "allow-undo-tweak",
    "allow-list-tweaks",
    "allow-scan-hardware",
    "allow-create-restore-point",
    "allow-restore-to-point",
    "allow-list-restore-points",
    "allow-start-pro-balance",
    "allow-stop-pro-balance",
    "allow-pro-balance-status",
    "allow-discord-login",
    "allow-discord-logout",
    "allow-discord-cached-token",
    "allow-check-for-update",
    "allow-env-info",
    "allow-read-text-file",
    "allow-open-downloads",
    "allow-scan-task-manager",
    "allow-kill-app",
    "allow-disable-startup-app",
    "allow-get-startup-value"
  ]
}
