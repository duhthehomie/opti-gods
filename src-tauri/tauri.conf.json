{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opti Gods",
  "version": "2.2.0",
  "identifier": "gg.optigods.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:5000",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Opti Gods",
        "width": 480,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": true,
        "url": "/splash.html"
      },
      {
        "label": "main",
        "title": "Opti Gods",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://optigods.replit.app https://discord.com https://*.discordapp.com http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "leaq",
    "copyright": "\u00a9 2026 leaq. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Windows 10/11 PC optimizer.",
    "longDescription": "Opti Gods is a Windows tuning toolkit for competitive gamers \u2014 registry, network, GPU, and process-priority tweaks with one-click apply and undo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNTg3NTIwNDlFNjdBNkIKUldScmV1WkpJSFZZNHVxTlp0ZVNLSUJsVTl2SXJKQUJHcm5iNG5ZVU1WbWhnYVJNenNvSk56NVoK",
      "endpoints": [
        "https://github.com/leaq/optigods/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}