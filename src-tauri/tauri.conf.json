{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opti Gods",
  "version": "2.3.6",
  "identifier": "gg.optigods.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npx vite build",
    "devUrl": "http://localhost:5000",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Opti Gods",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data: https: blob:; media-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://optigods.com https://optigods.replit.app https://discord.com https://*.discordapp.com http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "leaq",
    "copyright": "\u00a9 2026 leaq. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Windows 10/11 PC optimizer.",
    "longDescription": "Opti Gods is a Windows tuning toolkit for competitive gamers \u2014 registry, network, GPU, and process-priority tweaks with one-click apply and undo.",
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}