<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      version="2.0.0.0"
      processorArchitecture="*"
      name="OptiGods.Desktop"
      type="win32"/>
  <description>Opti Gods desktop client</description>

  <!-- Run as the invoking user — no UAC prompt on launch.
       Admin rights are only needed when the user downloads and runs the
       generated PowerShell script, which handles its own elevation via
       "Run as administrator". Requesting admin here caused silent launch
       failures on Windows 10 when the installer used currentUser mode. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Per-monitor V2 DPI awareness so the WinUI surface stays crisp on
       mixed-DPI multi-monitor setups (1080p + 4K is common for streamers). -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <!-- Declare compatibility with Windows 10 + 11. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
