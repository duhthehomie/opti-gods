@echo off
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo Requesting administrator privileges...
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$b = ''; $ps = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($b)); $t = [IO.Path]::GetTempFileName() + '.ps1'; [IO.File]::WriteAllText($t, $ps, (New-Object System.Text.UTF8Encoding $true)); & $t; Remove-Item $t -EA SilentlyContinue"
pause
