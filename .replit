modules = ["nodejs-20", "web", "python-3.11", "rust-stable", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", ".local", ".cache", "generated-icon.png", "node_modules", "dist", "src-tauri/target", "attached_assets", "downloads", "releases"]

[nix]
channel = "stable-24_05"
packages = ["zip", "unzip"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["bash", "-lc", "OPTI_DEPLOY_CLEANUP=1 node script/prepare-deployment.mjs before && npm run build && OPTI_DEPLOY_CLEANUP=1 node script/prepare-deployment.mjs after"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

