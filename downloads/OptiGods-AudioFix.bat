)
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
"$ErrorActionPreference = 'SilentlyContinue'; $Host.UI.RawUI.WindowTitle = 'Opti Gods - Audio Cutout Fix'; Write-Host ''; Write-Host ' OPTI GODS - Audio Cutout / Beep / Pop Fix' -ForegroundColor Red; Write-Host ' ============================================' -ForegroundColor DarkRed; Write-Host ''; $audio = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Audio'; if (!(Test-Path $audio)) { New-Item $audio -Force | Out-Null }; Set-ItemProperty $audio 'Scheduling Category' 'Medium' -Type String -Force; Set-ItemProperty $audio 'Priority' 6 -Type DWord -Force; Set-ItemProperty $audio 'SFIO Priority' 'High' -Type String -Force; Set-ItemProperty $audio 'Background Only' 'False' -Type String -Force; Set-ItemProperty $audio 'Clock Rate' 10000 -Type DWord -Force; Set-ItemProperty $audio 'GPU Priority' 8 -Type DWord -Force; Write-Host ' [OK] MMCSS Audio task: Priority=6, SFIO=High, ClockRate=0.5ms' -ForegroundColor Green; $proAudio = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Pro Audio'; if (!(Test-Path $proAudio)) { New-Item $proAudio -Force | Out-Null }; Set-ItemProperty $proAudio 'Scheduling Category' 'High' -Type String -Force; Set-ItemProperty $proAudio 'Priority' 6 -Type DWord -Force; Set-ItemProperty $proAudio 'SFIO Priority' 'High' -Type String -Force; Set-ItemProperty $proAudio 'Background Only' 'False' -Type String -Force; Set-ItemProperty $proAudio 'Clock Rate' 10000 -Type DWord -Force; Set-ItemProperty $proAudio 'GPU Priority' 8 -Type DWord -Force; Write-Host ' [OK] MMCSS Pro Audio task: High scheduling' -ForegroundColor Green; $sp = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile'; Set-ItemProperty $sp 'SystemResponsiveness' 10 -Type DWord -Force; Set-ItemProperty $sp 'NetworkThrottlingIndex' 0xFFFFFFFF -Type DWord -Force; Write-Host ' [OK] SystemResponsiveness=10, NetworkThrottling removed' -ForegroundColor Green; Write-Host ''; Write-Host ' Disabling audio enhancements on all playback devices...' -ForegroundColor Yellow; $renderPath = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render'; if (Test-Path $renderPath) { $devCount = 0; Get-ChildItem $renderPath | ForEach-Object { $propsPath = `"`$($_.PSPath)\Properties`"; if (Test-Path $propsPath) { Set-ItemProperty $propsPath '{1da5d803-d492-4edd-8c23-e0c0ffee7f0e},5' 1 -Type DWord -Force -EA SilentlyContinue; Set-ItemProperty $propsPath '{62ec7b65-4a0a-4e49-8a4e-16a6e95d756e},1' 0 -Type DWord -Force -EA SilentlyContinue; Set-ItemProperty $propsPath '{b3f8fa53-0004-438e-9003-51a46e139bfc},3' 1 -Type DWord -Force -EA SilentlyContinue; Set-ItemProperty $propsPath '{b3f8fa53-0004-438e-9003-51a46e139bfc},4' 1 -Type DWord -Force -EA SilentlyContinue; $devCount++ } }; Write-Host `" [OK] Enhancements disabled on $devCount device(s) — APO/EQ/Sonic chain killed`" -ForegroundColor Green } else { Write-Host ' [!] No render devices found' -ForegroundColor Yellow }; $rtPath = 'HKLM:\SYSTEM\CurrentControlSet\Control\Class\{4d36e96c-e325-11ce-bfc1-08002be10318}'; if (Test-Path $rtPath) { Get-ChildItem $rtPath -EA SilentlyContinue | ForEach-Object { $desc = (Get-ItemProperty $_.PSPath -EA SilentlyContinue).DriverDesc; if ($desc -match 'Realtek|HD Audio') { Set-ItemProperty $_.PSPath 'ConservationIdleTime' 0 -Type DWord -Force -EA SilentlyContinue; Set-ItemProperty $_.PSPath 'PerformanceIdleTime' 0 -Type DWord -Force -EA SilentlyContinue; Write-Host ' [OK] Realtek power management disabled — codec stays awake' -ForegroundColor Green } } }; Write-Host ''; Write-Host ' Done. No reboot needed — takes effect immediately.' -ForegroundColor Cyan; Write-Host ' If using Voicemeeter, restart it now.' -ForegroundColor Gray; Write-Host ''"
